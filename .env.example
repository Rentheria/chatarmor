# ChatArmor reads its provider key SERVER-SIDE ONLY. It never reaches the
# frontend. Copy this file to `.env` (gitignored) and fill in the real value.

# --- Provider (pick one) ----------------------------------------------------
# Google Gemini (the proven default)
GEMINI_API_KEY=

# OpenAI (optional alternative)
# OPENAI_API_KEY=

# --- Spend cap (llm-budget-cap) — bring your own Redis -----------------------
# The heart of the spend limit. Without it a bug or a distributed abuser can
# run your LLM bill up. Strongly recommended in production.
REDIS_URL=redis://localhost:6379
