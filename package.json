{
  "name": "chatarmor",
  "version": "0.2.0",
  "description": "Production-ready AI chat endpoint for NestJS over Gemini/OpenAI, with the protections indie devs forget: API key never on the frontend, timeout + total fallback (never crashes), anti-prompt-injection, and a hard spend cap via llm-budget-cap.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "angular",
    "README.md",
    "README.es.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "test:cov": "jest --runInBand --coverage",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "chatbot",
    "llm",
    "gemini",
    "openai",
    "nestjs",
    "angular",
    "ai-safety",
    "prompt-injection",
    "rate-limit",
    "spend-limit",
    "chat-widget",
    "ai"
  ],
  "author": "Alejandro Rentheria (Rentheria)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rentheria/chatarmor.git"
  },
  "bugs": {
    "url": "https://github.com/Rentheria/chatarmor/issues"
  },
  "homepage": "https://github.com/Rentheria/chatarmor#readme",
  "dependencies": {
    "llm-budget-cap": "^0.1.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "ioredis": ">=5"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.1.28",
    "@nestjs/testing": "^11.1.28",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "ioredis": "^5.4.2",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
